# Copy thành .env rồi chỉnh nếu cần
CALLOPS_REDIS_URL=redis://localhost:6379/0
CALLOPS_OPENSEARCH_URL=http://localhost:9200
# "auto": thử kết nối Redis/OpenSearch, lỗi thì fallback in-memory
# "memory": luôn dùng in-memory (không cần Docker)
CALLOPS_BACKEND=auto
CALLOPS_LOG_LEVEL=DEBUG
CALLOPS_LOG_DIR=logs
# Seed để kết quả mô phỏng lặp lại được
CALLOPS_SEED=42
